# Swaynag bar - bookmarked app
bindsym Control+slash exec '$app_shortcut'
# Swaynag bar - some system setting shortcut: network, etc.
bindsym Control+Shift+slash exec '$sys_shortcut'
# Swaynag bar - system control menu: shutdown, reboot, etc.
bindsym Control+$alt+Delete exec '$sys_control'
# Close swaynag notification bar
bindsym Control+$alt+Escape exec sh -c 'pgrep swaynag >/dev/null && pkill swaynag'
# Hide/unhide Waybar
bindsym $win+Shift+b exec pkill -SIGUSR1 waybar # Hide/unhide


# --- Next Direction Split of New Spawn Window ---
#
# The next split will be horizontal
#bindsym $win+b splith
bindsym $win+b exec sh -c 'swaymsg split h'
#
# The next split will be vertical
#bindsym $win+v splitv
bindsym $win+v exec sh -c 'swaymsg split v'


# --- Window ---
# Fullscreen for current focused window
bindsym F11      fullscreen
bindsym $win+f   fullscreen
# Switch focused window
bindsym $win+$left  focus left
bindsym $win+$right focus right
bindsym $win+$down  focus down
bindsym $win+$up    focus up
# Move focused window
bindsym $win+Shift+$left    move left
bindsym $win+Shift+$right   move right
bindsym $win+Shift+$down    move down
bindsym $win+Shift+$up      move up
# Kill focused window
bindsym $win+Shift+q    kill
bindsym $alt+F4         kill
# Switch window layout style
bindsym $win+s layout stacking
bindsym $win+w layout tabbed
bindsym $win+e layout toggle split
# Toggle floating for focused window
bindsym $win+Shift+space    floating toggle


# --- Scratchpad ---
# Hide/move active app to scratchpad
bindsym $win+Shift+m move scratchpad
# Cycle an app from scratchpad
bindsym $win+m scratchpad show


# --- Workspace ---
# Switch workspace
bindsym $win+1 workspace 1
bindsym $win+2 workspace 2
bindsym $win+3 workspace 3
bindsym $win+4 workspace 4
# Move focused window to workspace
bindsym $win+Shift+1 move container to workspace 1
bindsym $win+Shift+2 move container to workspace 2
bindsym $win+Shift+3 move container to workspace 3
bindsym $win+Shift+4 move container to workspace 4
# Move focused workspace to another display
bindsym $win+Ctrl+Shift+1 move workspace to output eDP-1
bindsym $win+Ctrl+Shift+2 move workspace to output HDMI-A-1


# Open application
bindsym $win+d               exec $menu             # run menu
bindsym $win+F1              exec $file_manager     # GUI file manager
bindsym $win+F2              exec $browser
bindsym $win+F3              exec bash -i -c '$browser_brave' # run app using shell
bindsym $win+Return          exec $terminal
bindsym Control+Shift+Escape exec swaymsg '[app_id="gnome-terminal-server"] focus' || gnome-terminal -e htop # run task manager


# --- Default Sway Configuration ---
include /etc/sway/config.d/*

# --- Startup App ---
# Mako Notifier
exec mako
# Autostart system tray applets
exec systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK
exec --no-startup-id nm-applet &
exec --no-startup-id blueman-applet &
